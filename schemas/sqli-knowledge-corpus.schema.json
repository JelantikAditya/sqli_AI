{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal SQL injection knowledge corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "source_lock_path", "source_lock_sha256", "curation", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_version": {"type": "string", "minLength": 1},
    "source_lock_path": {"const": "knowledge/sources.lock.json"},
    "source_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "curation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "researcher_review", "license", "notes"],
      "properties": {
        "method": {"const": "editorial-structured-paraphrase"},
        "researcher_review": {"enum": ["pending", "reviewed"]},
        "license": {"const": "CC-BY-SA-4.0"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "entries": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_id", "title", "vulnerability_type", "dbms", "functional_semantics", "root_cause", "detection_method", "payload_examples", "mitigation", "limitations", "source_refs"],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^sqli-(error|boolean|time)-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "vulnerability_type": {"enum": ["error-based", "boolean-based blind", "time-based blind"]},
          "dbms": {"enum": ["generic", "MySQL-compatible"]},
          "functional_semantics": {"type": "string", "minLength": 1},
          "root_cause": {"type": "string", "minLength": 1},
          "detection_method": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string", "minLength": 1},
          "limitations": {"type": "string", "minLength": 1},
          "payload_examples": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["purpose", "value", "adaptation"],
              "properties": {
                "purpose": {"type": "string", "minLength": 1},
                "value": {"type": "string", "minLength": 1},
                "adaptation": {"type": "string", "minLength": 1}
              }
            }
          },
          "source_refs": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "repository_path", "section", "line_start", "line_end"],
              "properties": {
                "source_id": {"enum": ["owasp-wstg", "payloadsallthethings"]},
                "repository_path": {"type": "string", "minLength": 1},
                "section": {"type": "string", "minLength": 1},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
