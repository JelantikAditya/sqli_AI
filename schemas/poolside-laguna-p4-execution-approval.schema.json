{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poolside-laguna-p4-execution-approval.schema.json",
  "title": "Researcher approval to execute the released P4 formal cohort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "decision",
    "experiment_id",
    "formal_plan_sha256",
    "budget_sha256",
    "protocol_sha256",
    "release_manifest_sha256",
    "maximum_spend_usd",
    "formal_execution_approval",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scope": { "const": "poolside-p4-formal-execution" },
    "decision": { "const": "approved-for-p4-formal-execution" },
    "experiment_id": { "const": "poolside-laguna-p4-20261023" },
    "formal_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "budget_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "protocol_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "release_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "maximum_spend_usd": { "const": 0 },
    "formal_execution_approval": { "const": true },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "basis", "approved_at_local", "quote"],
      "properties": {
        "role": { "const": "researcher" },
        "basis": { "const": "explicit-user-approval" },
        "approved_at_local": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
