      {
        "entry_id": "sqli-boolean-quoted",
        "technique": "boolean-based blind",
        "text": "{\"detection_method\": \"Send structurally matched true and false values, then map their content to stable response classes. Keep other request fields unchanged and do not infer the hidden query as ground truth.\", \"functional_semantics\": \"Closing a SQL string and adding a Boolean expression can yield two response classes. Balanced quotes allow the application remainder to close the final literal.\", \"limitations\": \"The pattern assumes a compatible quoted SQL context. Parentheses and comment handling may require adaptation; identical responses are inconclusive.\", \"title\": \"Balanced Boolean predicates in a quoted input\", \"vulnerability_type\": \"boolean-based blind\"}",
        "text_sha256": "3ca68d5c1b21f19314e2bef383ef0d824cac0c2b385f9c1a23f80a6118fd5a0c",
