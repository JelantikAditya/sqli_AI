    {
      "entry_id": "sqli-time-subselect",
      "technique": "time-based blind",
      "text": "{\"detection_method\": \"Keep the subselect, numeric input prefix and delay duration fixed; switch only the predicate. Compare observed timing with the no-delay control and account for ordinary request variation.\", \"functional_semantics\": \"A subselect can invoke SLEEP only when its WHERE predicate is satisfied. Comparing a satisfied and unsatisfied predicate exposes a timing difference without selecting target secrets.\", \"limitations\": \"A numeric context and compatible comment/subselect syntax are required. The number of evaluated rows and application logic can affect timing; no target configuration is assumed vulnerable.\", \"title\": \"Conditional sleep inside a subselect\", \"vulnerability_type\": \"time-based blind\"}",
